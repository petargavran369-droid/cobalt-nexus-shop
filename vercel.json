{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/adminapp/assets/:path*",
      "destination": "https://rust-admin-buddy-phi.vercel.app/assets/:path*"
    },
    {
      "source": "/adminapp/_build/:path*",
      "destination": "https://rust-admin-buddy-phi.vercel.app/_build/:path*"
    },
    {
      "source": "/adminapp/lovable-uploads/:path*",
      "destination": "https://rust-admin-buddy-phi.vercel.app/lovable-uploads/:path*"
    },
    {
      "source": "/adminapp/_serverFn/:path*",
      "destination": "https://rust-admin-buddy-phi.vercel.app/_serverFn/:path*"
    },
    {
      "source": "/_serverFn/:path*",
      "destination": "https://rust-admin-buddy-phi.vercel.app/_serverFn/:path*"
    },
    {
      "source": "/adminapp",
      "destination": "https://rust-admin-buddy-phi.vercel.app/adminapp/"
    },
    {
      "source": "/adminapp/:path*",
      "destination": "https://rust-admin-buddy-phi.vercel.app/adminapp/:path*"
    },
    {
      "source": "/auth/initiate",
      "destination": "https://lovable.app"
    }
  ]
}
